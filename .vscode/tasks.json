{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Android App",
			"type": "shell",
			"command": "${workspaceFolder}/gradlew.bat",
			"args": [
				"assembleDebug"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"isBackground": false,
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Clean Project",
			"type": "shell",
			"command": "${workspaceFolder}/gradlew.bat",
			"args": [
				"clean"
			],
			"group": "build",
			"isBackground": false,
			"options": {
				"cwd": "${workspaceFolder}"
			}
		}
	]
}